# Local secrets and credentials for the CLIs the skill spawns — never commit
.env
.env.*

# Local-only Claude Code overrides
.claude/

# Symlink to CLAUDE.md for non-Claude agent hosts — local convenience only
AGENTS.md

# Python virtualenvs used to run the helper scripts
.venv/
venv/

# Node deps for the localhost setup wizard tooling
node_modules/

# Python bytecode from scripts/ and tests/
**/__pycache__/
*.py[cod]

# unittest / pytest run caches
.pytest_cache/

# macOS / Windows filesystem cruft
.DS_Store
Thumbs.db

# Per-repo agent handoff runtime state — never publish
.handoff/
.partner/
.claude/agents/
